<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>График отпусков</title><style>
:root{--n:#1f4e78;--b:#d5dbe0;--bg:#f4f6f8;--g:#c6e0b4;--y:#ffe699;--r:#f8cbad;--u:#b4c6e7}*{box-sizing:border-box;font-family:Segoe UI,Arial}body{margin:0;background:var(--bg);color:#222}header{background:var(--n);color:#fff;padding:12px 18px;display:flex;gap:12px;align-items:center;flex-wrap:wrap}h1{font-size:18px;margin:0}.sync{font-size:12px;margin-left:auto}.bad{color:#ffb3b3;font-weight:bold}nav{display:flex;gap:6px}nav button,.btn{border:0;border-radius:5px;padding:7px 12px;cursor:pointer;background:#2e6da4;color:#fff}.active{background:#fff!important;color:var(--n)!important}.secondary{background:#fff!important;color:var(--n)!important;border:1px solid var(--n)!important}.danger{background:#e05252!important}.tiny{padding:4px 7px;font-size:11px}main{padding:16px;max-width:1600px;margin:auto}.tab{display:none}.tab.active{display:block}.card{background:#fff;border:1px solid var(--b);border-radius:8px;padding:14px;margin-bottom:14px}.tools{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;align-items:center}select,input{border:1px solid var(--b);border-radius:5px;padding:6px;font-size:13px}table{border-collapse:collapse;width:100%;font-size:12px}th,td{border:1px solid var(--b);padding:5px;text-align:left}th{background:#eef2f6}.scroll{max-height:65vh;overflow:auto}.calwrap{overflow:auto;max-height:70vh;border:1px solid var(--b)}.cal{border-collapse:collapse;width:auto;font-size:10px}.cal th,.cal td{border:1px solid #e5e9ed;padding:2px;text-align:center}.cal .month{background:var(--n);color:#fff}.day{width:20px;height:20px;min-width:20px;cursor:pointer}.weekend{background:#f4f4f4}.O{background:var(--g)}.D{background:var(--y)}.B{background:var(--r)}.U{background:var(--u)}.sel{background:#9fc5e8!important}.name{position:sticky;left:0;background:#fff;z-index:2;min-width:220px}.cal th.name{background:#eef2f6;z-index:3}.group td{background:#dbe6f0;font-weight:bold;color:var(--n)}.modalbg{display:none;position:fixed;inset:0;background:#0006;z-index:9;align-items:center;justify-content:center}.modalbg.open{display:flex}.modal{background:#fff;padding:18px;border-radius:8px;width:430px;max-width:94vw}.modal label{display:block;font-size:12px;font-weight:bold;margin-top:8px}.modal input,.modal select{width:100%}.actions{margin-top:14px;display:flex;justify-content:end;gap:7px}.warn{background:#fff3cd}.badrow{background:#fde2e2}#toast{position:fixed;right:18px;bottom:18px;background:#333;color:#fff;padding:10px 14px;border-radius:6px;display:none;z-index:20}.small{font-size:11px;color:#666}.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}.tabs button{padding:6px 10px;border:1px solid var(--n);border-radius:5px;background:#fff;color:var(--n);cursor:pointer}.tabs button.active{background:var(--n)!important;color:#fff!important}</style></head><body>
<header><h1>График отпусков — 2027</h1><span class="sync" id="sync">Загрузка…</span><nav><button class="active" data-t="emps">Сотрудники</button><button data-t="cal">Календарь</button><button data-t="sum">Свод</button></nav></header><main>
<section id="emps" class="tab active"><div class="card"><div class="tools"><select id="df"><option value="">Все отделения</option></select><select id="sf"><option value="">Все подразделения</option></select><input id="q" placeholder="Поиск"><button class="btn" id="add">+ Сотрудник</button><span class="small" id="cnt"></span></div><div class="scroll"><table><thead><tr><th>№</th><th>Отделение</th><th>Подразделение</th><th>ФИО</th><th>Должность</th><th>Группа</th><th>Дней</th><th></th></tr></thead><tbody id="elist"></tbody></table></div></div></section>
<section id="cal" class="tab"><div class="card"><div class="tabs" id="dtabs"></div><div class="tools"><select id="cs"><option value="">Все подразделения</option></select><select id="ct"><option value="sub">По подразделениям</option><option value="fio">По ФИО</option></select><select id="code"><option value="О">О — основной</option><option value="Д">Д — дополнительный</option><option value="Б">Б — больничный</option><option value="У">У — учебный</option><option value="">Очистить</option></select><button class="btn" id="apply">Применить</button><button class="btn secondary" id="clear">Сбросить</button></div><div class="calwrap"><table class="cal" id="calendar"></table></div></div></section>
<section id="sum" class="tab"><div class="card"><div class="scroll"><table><thead><tr><th>Группа</th><th>Чел.</th><th>Порог</th><th>Макс.</th><th>Дней превышения</th></tr></thead><tbody id="slist"></tbody></table></div></div></section>
</main><div class="modalbg" id="modal"><div class="modal"><h3 id="mt">Сотрудник</h3><input type="hidden" id="eid"><label>Отделение</label><select id="ed"></select><label>Подразделение</label><input id="esu"><label>ФИО</label><input id="ef"><label>Должность</label><input id="ej"><label>Группа</label><input id="eg"><div class="actions"><button class="btn secondary" id="cancel">Отмена</button><button class="btn" id="save">Сохранить</button></div></div></div><div id="toast"></div><script>
"use strict";
let D=null,R=0,Y=2027,ths={},dept='',sub='',cdept='',csub='',sel=[],selEmp='',selStart=0,drag=false,modal=null;const M=['Янв','Фев','Мар','Апр','Май','Июн','Июл','Авг','Сен','Окт','Ноя','Дек'],N='Без детального подразделения';
const $=x=>document.getElementById(x),esc=x=>String(x??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;'),pad=x=>x<10?'0'+x:x;
function idx(s){let p=s.split('-');return Math.round((new Date(+p[0],+p[1]-1,+p[2])-new Date(Y,0,1))/86400000)}function iso(i){let d=new Date(Y,0,1);d.setDate(d.getDate()+i);return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())}function pd(p){return idx(p.end)-idx(p.start)+1}function vd(e){return e.periods.filter(p=>p.type==='О'||p.type==='Д').reduce((s,p)=>s+pd(p),0)}function emp(id){return D.employees.find(e=>e.id===id)}function ei(id){return D.employees.findIndex(e=>e.id===id)}
function toast(s){$('toast').textContent=s;$('toast').style.display='block';clearTimeout(toast.t);toast.t=setTimeout(()=>$('toast').style.display='none',3500)}function status(ok){$('sync').className=ok?'sync':'sync bad';$('sync').textContent=ok?'● Синхронизировано '+new Date().toLocaleTimeString()+' · '+D.user:'● Нет связи с сервером'}
function api(m,u,b){let o={method:m,credentials:'same-origin',headers:{}};if(b!==undefined){o.headers['Content-Type']='application/json';o.body=JSON.stringify(b)}return fetch(u,o).then(r=>r.json().catch(()=>({})).then(j=>{if(!r.ok){let e=new Error(j.error||'HTTP '+r.status);e.status=r.status;e.data=j;throw e}return j}))}function load(){return api('GET','/api/data').then(x=>{D=x;R=x.rev;Y=x.year;ths=x.thresholds||{};status(true)})}function handle(e){if(e.status===409){toast('Запись изменена другим пользователем. Данные обновлены.');return load().then(renderAll)}if(e.status===401)toast('Нет доступа. Обновите страницу.');else{status(false);toast('Ошибка: '+e.message)}return Promise.resolve()}
function usedsubs(){let s={},z=false;D.employees.forEach(e=>e.subunit?s[e.subunit]=1:z=true);let a=Object.keys(s).sort((a,b)=>a.localeCompare(b,'ru'));if(z)a.push(N);return a}function options(id,a,first){let q=$(id),v=q.value;q.innerHTML=(first?'<option value="">'+esc(first)+'</option>':'')+a.map(x=>'<option value="'+esc(x)+'">'+esc(x)+'</option>').join('');q.value=a.includes(v)?v:(first?'':a[0]||'')}
function init(){let ds=D.departments;$('df').innerHTML='<option value="">Все отделения</option>'+ds.map(x=>'<option value="'+x+'">'+esc(D.deptLabels[x])+'</option>').join('');$('ed').innerHTML=ds.map(x=>'<option value="'+x+'">'+esc(D.deptLabels[x])+'</option>').join('');cdept=ds[0];$('dtabs').innerHTML=ds.map(x=>'<button data-d="'+x+'">'+esc(D.deptLabels[x])+'</button>').join('');refreshSel()}function refreshSel(){options('sf',usedsubs(),'Все подразделения');let a=[...new Set(D.employees.filter(e=>e.dept===cdept&&e.subunit).map(e=>e.subunit))].sort((a,b)=>a.localeCompare(b,'ru'));options('cs',a,'Все подразделения');$('dtabs').querySelectorAll('button').forEach(b=>b.classList.toggle('active',b.dataset.d===cdept))}
function renderEmp(){let q=$('q').value.toLowerCase(),a=D.employees.filter(e=>(!dept||e.dept===dept)&&(!sub||(e.subunit||N)===sub)&&(!q||(e.fio+' '+e.job).toLowerCase().includes(q))).sort((a,b)=>a.fio.localeCompare(b.fio,'ru'));$('cnt').textContent='Всего: '+a.length;$('elist').innerHTML=a.map((e,i)=>'<tr><td>'+ (i+1)+'</td><td>'+esc(D.deptLabels[e.dept])+'</td><td>'+esc(e.subunit)+'</td><td>'+esc(e.fio)+'</td><td>'+esc(e.job)+'</td><td>'+esc(e.group)+'</td><td>'+vd(e)+'</td><td><button class="btn tiny secondary" data-edit="'+e.id+'">Изм.</button> <button class="btn tiny danger" data-del="'+e.id+'">Удал.</button></td></tr>').join('')}
function open(e){modal=e||null;$('mt').textContent=e?'Изменить сотрудника':'Добавить сотрудника';$('eid').value=e?e.id:'';$('ed').value=e?e.dept:(dept||D.departments[0]);$('esu').value=e?e.subunit:'';$('ef').value=e?e.fio:'';$('ej').value=e?e.job:'';$('eg').value=e?e.group:'';$('modal').classList.add('open')}function close(){$('modal').classList.remove('open')}function save(){let b={dept:$('ed').value,subunit:$('esu').value.trim(),fio:$('ef').value.trim(),job:$('ej').value.trim(),group:$('eg').value.trim()};if(!b.fio)return toast('Укажите ФИО');let p;if(modal){b.version=modal.version;p=api('PUT','/api/employees/'+modal.id,b).then(r=>{D.employees[ei(modal.id)]=r.employee;R=r.rev})}else p=api('POST','/api/employees',b).then(r=>{D.employees.push(r.employee);R=r.rev});p.then(()=>{close();refreshSel();renderAll()}).catch(handle)}
function code(e,d){for(let p of e.periods)if(d>=idx(p.start)&&d<=idx(p.end))return p.type;return''}function merge(e){let by={};e.periods.forEach(p=>(by[p.type]||(by[p.type]=[])).push([idx(p.start),idx(p.end)]));let o=[];for(let t in by){let a=by[t].sort((x,y)=>x[0]-y[0]),z=a[0];for(let i=1;i<a.length;i++){if(a[i][0]<=z[1]+1)z[1]=Math.max(z[1],a[i][1]);else{o.push([z[0],z[1],t]);z=a[i]}}o.push([z[0],z[1],t])}e.periods=o.sort((a,b)=>a[0]-b[0]).map(x=>({start:iso(x[0]),end:iso(x[1]),type:x[2]}))}function setday(e,d,t){let o=[];for(let p of e.periods){let s=idx(p.start),z=idx(p.end);if(d<s||d>z){o.push(p);continue}if(s===z)continue;if(d===s){o.push({start:iso(s+1),end:p.end,type:p.type});continue}if(d===z){o.push({start:p.start,end:iso(z-1),type:p.type});continue}o.push({start:p.start,end:iso(d-1),type:p.type},{start:iso(d+1),end:p.end,type:p.type})}e.periods=o;if(t)e.periods.push({start:iso(d),end:iso(d),type:t});merge(e)}
function renderCal(){refreshSel();let a=D.employees.filter(e=>e.dept===cdept&&(!csub||e.subunit===csub)).sort((a,b)=>{let x=a.subunit||N,y=b.subunit||N;return $('ct').value==='sub'&&x!==y?x.localeCompare(y,'ru'):a.fio.localeCompare(b.fio,'ru')});let md=[],tot=0;for(let m=0;m<12;m++){md[m]=new Date(Y,m+1,0).getDate();tot+=md[m]}let h='<tr><th class="name">ФИО / День</th>',dh='<tr><th class="name"></th>';for(let m=0;m<12;m++){h+='<th class="month" colspan="'+md[m]+'">'+M[m]+'</th>';for(let d=1;d<=md[m];d++){let w=new Date(Y,m,d).getDay();dh+='<th class="'+(w===0||w===6?'weekend':'')+'">'+d+'</th>'}}h+='</tr>';dh+='</tr>';let body='',last=null;a.forEach(e=>{let su=e.subunit||N;if($('ct').value==='sub'&&su!==last){body+='<tr class="group"><td colspan="'+(tot+1)+'">'+esc(su)+'</td></tr>';last=su}body+='<tr><td class="name">'+esc(e.fio)+'<br><span class="small">'+esc(e.job)+'</span></td>';let dc=0;for(let m=0;m<12;m++)for(let d=1;d<=md[m];d++){let w=new Date(Y,m,d).getDay(),t=code(e,dc),cl='day '+((w===0||w===6)?'weekend ':'')+(t||'');body+='<td class="'+cl+'" data-e="'+e.id+'" data-d="'+dc+'"></td>';dc++}body+='</tr>'});$('calendar').innerHTML='<thead>'+h+dh+'</thead><tbody>'+body+'</tbody>'}
function hilite(a,b,id){$('calendar').querySelectorAll('.sel').forEach(x=>x.classList.remove('sel'));sel=[];for(let d=Math.min(a,b);d<=Math.max(a,b);d++){let x=$('calendar').querySelector('[data-e="'+id+'"][data-d="'+d+'"]');if(x){x.classList.add('sel');sel.push(d)}}}
function occ(g){let c=Array(365).fill(0);D.employees.filter(e=>e.group===g).forEach(e=>e.periods.filter(p=>p.type==='О'||p.type==='Д').forEach(p=>{for(let d=idx(p.start);d<=idx(p.end);d++)c[d]++}));return c}function renderSum(){let gs=[...new Set(D.employees.map(e=>e.group))].sort((a,b)=>a.localeCompare(b,'ru'));$('slist').innerHTML=gs.map(g=>{let c=occ(g),t=ths[g]??2,max=Math.max(...c),ex=c.filter(x=>x>t).length;return'<tr class="'+(ex?'badrow':max?'warn':'')+'"><td>'+esc(g)+'</td><td>'+D.employees.filter(e=>e.group===g).length+'</td><td><input class="thr" data-g="'+esc(g)+'" value="'+t+'" type="number" min="0"></td><td>'+max+'</td><td>'+ex+'</td></tr>'}).join('')}
function renderAll(){renderEmp();renderCal();renderSum()}
function bind(){document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>{document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));$(b.dataset.t).classList.add('active')});$('df').onchange=()=>{dept=$('df').value;renderEmp()};$('sf').onchange=()=>{sub=$('sf').value;renderEmp()};$('q').oninput=renderEmp;$('add').onclick=()=>open(null);$('cancel').onclick=close;$('save').onclick=save;$('elist').onclick=e=>{let b=e.target.closest('button');if(!b)return;let id=+(b.dataset.edit||b.dataset.del);if(b.dataset.edit)open(emp(id));else if(b.dataset.del&&confirm('Удалить сотрудника?'))api('DELETE','/api/employees/'+id).then(()=>load().then(renderAll)).catch(handle)};$('dtabs').onclick=e=>{let b=e.target.closest('button');if(!b)return;cdept=b.dataset.d;csub='';renderCal()};$('cs').onchange=()=>{csub=$('cs').value;renderCal()};$('ct').onchange=renderCal;$('calendar').onmousedown=e=>{let x=e.target.closest('.day');if(!x)return;drag=true;selEmp=x.dataset.e;selStart=+x.dataset.d;hilite(selStart,selStart,selEmp)};$('calendar').onmouseover=e=>{if(!drag)return;let x=e.target.closest('.day');if(x&&x.dataset.e===selEmp)hilite(selStart,+x.dataset.d,selEmp)};document.onmouseup=()=>drag=false;$('clear').onclick=()=>{$('calendar').querySelectorAll('.sel').forEach(x=>x.classList.remove('sel'));sel=[]};$('apply').onclick=()=>{if(!sel.length)return toast('Сначала выделите дни');let e=emp(+selEmp),copy={periods:JSON.parse(JSON.stringify(e.periods))};sel.forEach(d=>setday(copy,d,$('code').value));api('PUT','/api/employees/'+e.id+'/periods',{version:e.version,periods:copy.periods}).then(r=>{D.employees[ei(e.id)]=r.employee;R=r.rev;renderAll()}).catch(handle)};$('slist').onchange=e=>{let x=e.target.closest('.thr');if(!x)return;api('PUT','/api/thresholds',{group:x.dataset.g,value:+x.value}).then(r=>{ths=r.thresholds;R=r.rev;renderSum()}).catch(handle)}}
function start(){load().then(()=>{init();renderAll();bind();setInterval(()=>api('GET','/api/rev').then(r=>{if(r.rev!==R)return load().then(renderAll)}).catch(()=>status(false)),15000)}).catch(handle)}start();
</script></body></html>